# =============================================================================
# OpenCoding — local development environment template
# =============================================================================
# Copy this file to `.env` and fill in the values for your local setup.
# `.env` is gitignored; `.env.example` is the tracked template.
#
# Resolution order at runtime:
#   1. OS env vars / shell `export`         (highest)
#   2. IntelliJ run config's .env plugin    (Ultimate feature)
#   3. .env file loaded by dotenv-java in   (lowest — dev only)
#      OpenCodingApplication#loadDotenv()
# =============================================================================

# ---- Application ----
SERVER_PORT=8080
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_WEB=INFO
LOG_LEVEL_SQL=DEBUG

# ---- PostgreSQL ----
DB_URL=jdbc:postgresql://localhost:5432/opencoding?stringtype=unspecified
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_CONN_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=600000
DB_POOL_MAX_LIFETIME=1800000

# ---- Flyway ----
FLYWAY_ENABLED=true

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=3000ms
REDIS_POOL_ENABLED=true
REDIS_POOL_MAX_ACTIVE=16
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=2

# ---- Springdoc / Swagger UI ----
SWAGGER_ENABLED=true

# ---- Anthropic ----
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=
